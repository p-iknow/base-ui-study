{
  "name": "@repo/package",
  "version": "0.1.0",
  "description": "Template TypeScript package for publishable library code.",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@repo/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./create-greeting": {
      "@repo/source": "./src/create-greeting.ts",
      "import": {
        "types": "./dist/create-greeting.d.ts",
        "default": "./dist/create-greeting.js"
      },
      "require": {
        "types": "./dist/create-greeting.d.cts",
        "default": "./dist/create-greeting.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:attw": "attw --pack --profile node16",
    "test:publint": "publint",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "publint": "^0.3.20",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "@base-ui-study/react",
  "version": "0.1.0",
  "description": "Study package for cloning Base UI headless component patterns.",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@repo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./separator": {
      "@repo/source": "./src/separator/index.ts",
      "types": "./dist/separator/index.d.ts",
      "import": "./dist/separator/index.js",
      "default": "./dist/separator/index.js"
    },
    "./button": {
      "@repo/source": "./src/button/index.ts",
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./input": {
      "@repo/source": "./src/input/index.ts",
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js",
      "default": "./dist/input/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui-study/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
